# Конфигурация тестовых баз данных
# Скопируйте этот файл в .env и измените значения по необходимости

# Привязка хоста для портов баз данных
# Значения:
#   0.0.0.0   - доступ извне (со всех интерфейсов, включая внешние сети)
#   127.0.0.1 - только локальный доступ (localhost)
#
# ВНИМАНИЕ: Для production окружения рекомендуется использовать 127.0.0.1
DB_HOST_BIND=127.0.0.1

# Порты баз данных
MYSQL_PORT=3306
POSTGRES_PORT=5432

# MySQL настройки
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=customer_db
MYSQL_USER=testuser
MYSQL_PASSWORD=testpass123

# PostgreSQL настройки
POSTGRES_DB=customer_db
POSTGRES_USER=testuser
POSTGRES_PASSWORD=testpass123
